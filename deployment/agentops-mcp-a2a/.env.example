# Copy this file to .env and replace every value with a unique secret.
# Never commit .env or use these values in a shared/production environment.
POSTGRES_ADMIN_PASSWORD=replace-with-long-random-postgres-admin-password
KC_DB_PASSWORD=replace-with-long-random-keycloak-db-password
AGENTOPS_DB_PASSWORD=replace-with-long-random-agentops-db-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=replace-with-long-random-keycloak-admin-password
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-with-long-random-grafana-password

# Configure a confidential Keycloak client used by MCP/A2A servers to introspect tokens.
KEYCLOAK_RESOURCE_CLIENT_ID=agentops-resource-server
KEYCLOAK_RESOURCE_CLIENT_SECRET=replace-with-client-secret-from-keycloak
KEYCLOAK_EXPECTED_AUDIENCE=agentops-resource-server
KEYCLOAK_ISSUER_URL=http://localhost:8080/realms/agentops
KEYCLOAK_INTROSPECTION_URL=http://keycloak:8080/realms/agentops/protocol/openid-connect/token/introspect

# Public-facing local endpoints (change when deploying behind HTTPS ingress).
MCP_PUBLIC_URL=http://localhost:8000/mcp
MCP_ALLOWED_HOSTS=localhost:8000,127.0.0.1:8000
MCP_ALLOWED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
A2A_PUBLIC_URL=http://localhost:9001/
A2A_ALLOWED_ORIGINS=http://localhost:9001,http://127.0.0.1:9001

# Optional image overrides. Pin tested versions/digests for controlled releases.
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:latest
OTEL_COLLECTOR_IMAGE=otel/opentelemetry-collector-contrib:latest
PROMETHEUS_IMAGE=prom/prometheus:latest
GRAFANA_IMAGE=grafana/grafana:latest
